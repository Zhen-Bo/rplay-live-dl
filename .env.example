# Required: your RPlay user number
USER_OID=

# Required: copy session.refreshToken from the logged-in browser (see README)
REFRESH_TOKEN=

# Optional: renew before key2 when JWT has fewer than this many seconds left
# Non-negative integer; 0 refreshes only when expired; no background timer
TOKEN_REFRESH_LEEWAY_SECONDS=300

# Optional: monitor poll interval in seconds (10-3600)
INTERVAL=60

# Optional: min free disk GiB before recording (0 disables; invalid aborts startup)
MIN_FREE_DISK_GB=5

# Archive capacity alerts (GiB); alerts never stop an active recording.
# Critical must be below warning; recovery needs the extra margin.
DISK_WARNING_GB=30
DISK_CRITICAL_GB=10
DISK_RECOVERY_MARGIN_GB=2
DISK_REMINDER_SECONDS=3600

# Preflight both live merges and startup recovery. Insufficient space preserves
# raw inputs; free space and restart to retry. 1.1 covers the FFmpeg output
# (minimum 1). Use 2.2 on exFAT/CIFS, where the final MP4 is copied, not linked.
MERGE_MIN_FREE_DISK_GB=1
MERGE_SPACE_MULTIPLIER=1.1

# Optional Discord incoming webhook. Empty disables all network notifications.
# Treat the URL as a secret: never commit it. English embed cards; no mentions.
DISCORD_WEBHOOK_URL=
# Comma-separated events; empty disables notifications. Restart/recreate to apply.
DISCORD_WEBHOOK_EVENTS=live,offline,blocked,auth_failed,download_failed,merge_failed,merge_completed,disk_warning,disk_critical

# Optional: application log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Optional: surface yt-dlp internal debug chatter
# Truthy values: 1, true, yes, on
LOG_YTDLP_INTERNAL=false

# Optional: log rotation settings
# LOG_MAX_SIZE_MB: 1-100
# LOG_BACKUP_COUNT: 1-50
# LOG_RETENTION_DAYS: 1-365
LOG_MAX_SIZE_MB=5
LOG_BACKUP_COUNT=5
LOG_RETENTION_DAYS=30

# Optional: startup metadata shown as Git SHA in logs
# Usually injected automatically during Docker image builds
APP_GIT_SHA=
